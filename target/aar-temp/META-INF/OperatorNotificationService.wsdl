<?xml version="1.0" encoding="UTF-8"?>
<definitions targetNamespace="http://telecom.com/operator" xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:tns="http://telecom.com/operator" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">
  <types>
    <xs:schema>
            <xs:import namespace="http://telecom.com/operator" schemaLocation="NotifyOperator.xsd"/>

            <xs:import namespace="http://telecom.com/operator" schemaLocation="NotifyAck.xsd"/>
        </xs:schema>
  </types>
  <message name="NotifyAckMessage">
    <part name="parameters" element="tns:NotifyAck">
    </part>
  </message>
  <message name="NotifyOperatorMessage">
    <part name="parameters" element="tns:NotifyOperator">
    </part>
  </message>
  <portType name="OperatorNotificationPortType">
    <operation name="notifyOperator">
      <input message="tns:NotifyOperatorMessage">
    </input>
      <output message="tns:NotifyAckMessage">
    </output>
    </operation>
  </portType>
  <binding name="OperatorNotificationBinding" type="tns:OperatorNotificationPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="notifyOperator">
      <soap:operation soapAction="notifyOperator"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>
  </binding>
  <service name="OperatorNotificationService">
    <port name="OperatorNotificationPort" binding="tns:OperatorNotificationBinding">
      <soap:address location="http://localhost:8080/operator-notification"/>
    </port>
  </service>
</definitions>
